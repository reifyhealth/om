;; Toolchain for the ClojureScript test suite (`npm test`). The library's own
;; build is described by project.clj / build.boot; nothing here is a dependency
;; of om itself.
{:paths ["src/main" "src/test" "src/test-node"]
 :deps  {thheller/shadow-cljs        {:mvn/version "2.15.12"}
         org.clojure/clojurescript   {:mvn/version "1.10.879"}
         com.cognitect/transit-cljs  {:mvn/version "0.8.239"}}}
